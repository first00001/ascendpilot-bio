{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RiceFM annotation request",
  "type": "object",
  "required": ["genes", "counts"],
  "additionalProperties": false,
  "properties": {
    "genes": {"type": "array", "minItems": 1, "maxItems": 25, "uniqueItems": true, "items": {"type": "string", "pattern": "^ZH[0-9]{2}G[0-9]{5}$"}},
    "counts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": {"type": "array", "items": {"type": "number", "minimum": 0}}
    },
    "k": {"type": "integer", "minimum": 1, "maximum": 25, "default": 5}
  }
}
